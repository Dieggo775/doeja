# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NUNCA deve ir para o GitHub.
DB_NAME=doeja
DB_USER=doeja
DB_PASSWORD=
# Opcionais (portas públicas no servidor)
# DB_PORT=5434
# FRONTEND_PORT=3100

# Chave dos tokens de login: no mínimo 32 caracteres aleatórios.
# Gere com:  openssl rand -base64 48
JWT_SECRET=

# Conta de administrador criada na primeira subida
ADMIN_EMAIL=
ADMIN_SENHA=

# Demonstração: instituições fictícias + contas de teste (doador@doeja.example etc.)
# Em produção com instituições reais: DEMO_ENABLED=false
DEMO_ENABLED=true
DEMO_SENHA=
